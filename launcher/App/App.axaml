<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HookshotLauncher.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Slate, frosted: builder/HookshotBuilder/App.xaml's palette, by the same names -->
      <SolidColorBrush x:Key="Page" Color="#14161A"/>
      <SolidColorBrush x:Key="Raised" Color="#1C1F24"/>
      <SolidColorBrush x:Key="RaisedHover" Color="#23272D"/>
      <SolidColorBrush x:Key="Line" Color="#2C3037"/>
      <SolidColorBrush x:Key="LineStrong" Color="#3D434C"/>
      <SolidColorBrush x:Key="Ink" Color="#EDEFF2"/>
      <SolidColorBrush x:Key="InkSoft" Color="#A2A9B3"/>
      <SolidColorBrush x:Key="InkFaint" Color="#6E7681"/>
      <SolidColorBrush x:Key="Brand" Color="#3D63E6"/>
      <SolidColorBrush x:Key="BrandHover" Color="#4B70F0"/>
      <SolidColorBrush x:Key="BrandInk" Color="#DFE6FF"/>
      <SolidColorBrush x:Key="Go" Color="#5FB08A"/>
      <SolidColorBrush x:Key="GoHover" Color="#70C09A"/>
      <SolidColorBrush x:Key="GoInk" Color="#06150E"/>
      <SolidColorBrush x:Key="Warn" Color="#E2B86B"/>
      <SolidColorBrush x:Key="Bad" Color="#E2776B"/>
      <SolidColorBrush x:Key="Accent" Color="#5FB08A"/>
      <SolidColorBrush x:Key="Glass" Color="#0DFFFFFF"/>
      <SolidColorBrush x:Key="GlassHover" Color="#17FFFFFF"/>
      <SolidColorBrush x:Key="GlassLine" Color="#17FFFFFF"/>
      <SolidColorBrush x:Key="GlassLineStrong" Color="#2AFFFFFF"/>
      <SolidColorBrush x:Key="GoSoft" Color="#265FB08A"/>
      <SolidColorBrush x:Key="BadSoft" Color="#26E2776B"/>
      <SolidColorBrush x:Key="WarnSoft" Color="#1FE2B86B"/>
      <SolidColorBrush x:Key="BrandSoft" Color="#333D63E6"/>
      <FontFamily x:Key="Ui">avares://HookshotLauncher/Assets/Fonts#Inter</FontFamily>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme/>

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
      <Setter Property="Background" Value="{StaticResource Page}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="TextBlock.sub">
      <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.faint">
      <Setter Property="Foreground" Value="{StaticResource InkFaint}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource Glass}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <!-- a pill: the radius half the height -->
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="#0DFFFFFF"/>
      <Setter Property="BorderBrush" Value="#14FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="CornerRadius" Value="11"/>
      <Setter Property="Padding" Value="9,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.chip > TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
    </Style>
    <Style Selector="Border.chip.go">
      <Setter Property="Background" Value="{StaticResource GoSoft}"/>
    </Style>
    <Style Selector="Border.chip.go > TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Go}"/>
    </Style>
    <Style Selector="Border.chip.brand">
      <Setter Property="Background" Value="{StaticResource BrandSoft}"/>
    </Style>
    <Style Selector="Border.chip.brand > TextBlock">
      <Setter Property="Foreground" Value="{StaticResource BrandInk}"/>
    </Style>
    <Style Selector="Border.chip.warn">
      <Setter Property="Background" Value="{StaticResource WarnSoft}"/>
    </Style>
    <Style Selector="Border.chip.warn > TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Warn}"/>
    </Style>

    <!-- buttons: quiet (glass), primary (blue: the step's action), go (green: Play) -->
    <Style Selector="Button">
      <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="#08FFFFFF"/>
      <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource GlassHover}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassLineStrong}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource Brand}"/>
      <Setter Property="BorderBrush" Value="#33FFFFFF"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrandHover}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.go">
      <Setter Property="Background" Value="{StaticResource Go}"/>
      <Setter Property="BorderBrush" Value="#33FFFFFF"/>
      <Setter Property="Foreground" Value="{StaticResource GoInk}"/>
    </Style>
    <Style Selector="Button.go:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource GoHover}"/>
      <Setter Property="Foreground" Value="{StaticResource GoInk}"/>
    </Style>
    <Style Selector="Button.big">
      <Setter Property="Height" Value="48"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Padding" Value="34,0"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Button.bad">
      <Setter Property="Foreground" Value="{StaticResource Bad}"/>
    </Style>
    <Style Selector="Button.small">
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- the channel choice: three pills -->
    <Style Selector="ListBox.segments">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBox.segments ListBoxItem">
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Background" Value="#08FFFFFF"/>
      <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="ListBox.segments ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrandSoft}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Brand}"/>
    </Style>
  </Application.Styles>
</Application>
