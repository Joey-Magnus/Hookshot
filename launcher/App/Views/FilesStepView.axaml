<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HookshotLauncher.ViewModels"
             xmlns:c="using:HookshotLauncher.Controls"
             x:Class="HookshotLauncher.Views.FilesStepView"
             x:DataType="vm:FilesStepViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.dimname">
      <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <c:Icon Kind="check" Width="14" Height="14" Foreground="{StaticResource Go}" IsVisible="{Binding CanNext}" VerticalAlignment="Center"/>
        <TextBlock Classes="faint" Classes.ok="{Binding CanNext}" Text="{Binding Hint}" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
        <Button Content="Back" Command="{Binding BackCommand}"/>
        <Button Classes="primary" Content="Next" Command="{Binding NextCommand}"/>
      </StackPanel>
    </Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="-8,0" Padding="8,0,8,4">
      <StackPanel>
        <TextBlock Classes="heading" Text="Your game files"/>
        <TextBlock Classes="sub" Text="{Binding Sub}"/>

        <!-- the version's tools, downloading while the files are picked -->
        <Border Classes="card" Margin="0,16,0,0" Padding="16,10">
          <Grid ColumnDefinitions="34,*,190" ColumnSpacing="14">
            <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource BrandSoft}" IsVisible="{Binding !ToolsDone}">
              <c:Icon Kind="download" Width="17" Height="17" Foreground="{StaticResource InfoInk}"/>
            </Border>
            <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource GoSoft}" IsVisible="{Binding ToolsDone}">
              <c:Icon Kind="check" Width="17" Height="17" Foreground="{StaticResource Go}"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding ToolsTitle}" FontWeight="SemiBold"/>
              <TextBlock FontSize="12" Foreground="{StaticResource InkSoft}" Classes.bad="{Binding ToolsFailed}" Text="{Binding ToolsNote}"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Panel Grid.Column="2" VerticalAlignment="Center">
              <c:Bar Value="{Binding ToolsFraction}" Fill="{StaticResource Brand}" IsVisible="{Binding ToolsBusy}"/>
              <c:Bar Value="1" Fill="{StaticResource Go}" IsVisible="{Binding ToolsDone}"/>
              <Button Classes="small" Content="Try again" Command="{Binding RetryCommand}" IsVisible="{Binding ToolsFailed}" HorizontalAlignment="Right"/>
            </Panel>
          </Grid>
        </Border>

        <TextBlock Classes="label" Text="FOUND ON THIS PC" Margin="0,18,0,10"/>
        <Border Classes="card">
          <Panel>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,14" IsVisible="{Binding Searching}">
              <c:Spinner VerticalAlignment="Center"/>
              <TextBlock Classes="note" Text="Looking for your game files…"/>
            </StackPanel>
            <TextBlock Classes="note" Margin="16,14" IsVisible="{Binding NothingFound}"
                       Text="No game file in Downloads, Desktop, Documents or the top of your drives. Browse for it, or drop it here."/>
            <ItemsControl ItemsSource="{Binding Files}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GameFileViewModel">
                  <Border BorderBrush="{StaticResource GlassLine}" BorderThickness="0,0,0,1" Margin="0,0,0,-1">
                    <RadioButton Classes="row" GroupName="dump" IsChecked="{Binding IsPicked}" IsEnabled="{Binding CanPick}">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                     Classes.dimname="{Binding Dim}"/>
                          <TextBlock Classes="faint path" Text="{Binding Where}" ToolTip.Tip="{Binding WhereFull}"/>
                        </StackPanel>
                        <Panel Grid.Column="1" VerticalAlignment="Center" ToolTip.Tip="{Binding Tip}">
                          <Border Classes="chip" IsVisible="{Binding Checking}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <c:Spinner Width="12" Height="12" VerticalAlignment="Center"/>
                              <TextBlock Text="{Binding ChipText}"/>
                            </StackPanel>
                          </Border>
                          <Border Classes="chip go" IsVisible="{Binding Ok}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <c:Icon Kind="check" Width="13" Height="13" VerticalAlignment="Center"/>
                              <TextBlock Text="{Binding ChipText}"/>
                            </StackPanel>
                          </Border>
                          <Border Classes="chip warn" IsVisible="{Binding Old}"><TextBlock Text="{Binding ChipText}"/></Border>
                          <Border Classes="chip bad" IsVisible="{Binding Bad}"><TextBlock Text="{Binding ChipText}"/></Border>
                        </Panel>
                      </Grid>
                    </RadioButton>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Panel>
        </Border>
        <WrapPanel Margin="0,10,0,0">
          <TextBlock Classes="note" Text="Not listed?" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <Button Classes="link" Content="Browse…" Command="{Binding BrowseCommand}"/>
          <TextBlock Classes="note" Text=", drop the file on this window, or pick its" VerticalAlignment="Center" Margin="4,0"/>
          <Button Classes="link soft" Content="romfs and exefs folders" Command="{Binding FoldersCommand}"/>
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
